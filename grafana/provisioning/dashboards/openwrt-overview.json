    {
      "type": "timeseries",
      "id": 11,
      "title": "CPU Usage by Mode (all cores)",
      "description": "CPU time breakdown across all 4 threads. softirq = network packet processing (normal on a router).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(node_cpu_seconds_total{job=\"openwrt\", router=\"$router\", mode=\"user\"}[$__rate_interval]))",
          "legendFormat": "user",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(node_cpu_seconds_total{job=\"openwrt\", router=\"$router\", mode=\"system\"}[$__rate_interval]))",
          "legendFormat": "system",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(node_cpu_seconds_total{job=\"openwrt\", router=\"$router\", mode=\"softirq\"}[$__rate_interval]))",
          "legendFormat": "softirq",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(node_cpu_seconds_total{job=\"openwrt\", router=\"$router\", mode=\"iowait\"}[$__rate_interval]))",
          "legendFormat": "iowait",
          "refId": "D"
        }
      ],
      "fieldConfig": {
