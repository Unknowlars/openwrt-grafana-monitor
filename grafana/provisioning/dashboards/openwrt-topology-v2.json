      "panel-100": {
        "kind": "Panel",
        "spec": {
          "id": 100,
          "title": "Network Topology",
          "description": "internet -> router -> AP -> SSID -> client. Node mainstat is the node's own metric value (see this builder's module docstring for why edge-derived node stats were not chosen). Isolated client nodes mean connection state is unknown (assoclist unavailable), not that the client is wired -- the collector never guesses.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "edges",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${DS_PROMETHEUS}"
                      },
                      "spec": {
                        "expr": "openwrt_topology_edge{job=\"openwrt\", router=~\"$router\"}",
                        "legendFormat": "",
                        "format": "table",
                        "instant": true
                      }
