                    "options": {
                      "excludeByName": {
                        "Time": true,
                        "__name__": true,
                        "job": true,
                        "instance": true,
                        "router": true,
                        "cluster": true,
                        "endpoint": true,
                        "namespace": true,
                        "prometheus": true,
                        "prometheus_replica": true,
                        "service": true
                      },
                      "renameByName": {
                        "Value": "mainstat"
                      },
                      "indexByName": {}
