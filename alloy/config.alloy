// ============================================================================
// OpenWRT Grafana Monitor — Grafana Alloy Configuration
// ============================================================================
//
// This config:
//   1. Scrapes Prometheus metrics from prometheus-node-exporter-lua on the router
//   2. Receives syslog from OpenWRT's logd over UDP/TCP on port 514
//   3. Forwards metrics to Prometheus in the otel-lgtm container
//   4. Forwards logs to Loki in the otel-lgtm container
//
// Environment variables (set via docker-compose):
//   ROUTER_TARGETS      — Optional comma-separated scrape targets:
//                         name=ip:port,name=ip:port
//   ROUTER_IP           — IP of the OpenWRT router when ROUTER_TARGETS is unset
//   ROUTER_NAME         — Label value when ROUTER_TARGETS is unset
//   ROUTER_METRICS_PORT — Port of prometheus-node-exporter-lua
//   SCRAPE_INTERVAL     — How often to scrape metrics
// ============================================================================

// ── Prometheus: scrape OpenWRT metrics ──────────────────────────────────────

// docker-compose generates this Prometheus file-SD target file at container
// startup. It contains either ROUTER_TARGETS entries or the legacy
// ROUTER_IP/ROUTER_NAME single target, preserving the existing default path.
discovery.file "openwrt_targets" {
  files = ["/tmp/openwrt-targets.json"]
}

prometheus.scrape "openwrt" {
  targets = discovery.file.openwrt_targets.targets

  scrape_interval = sys.env("SCRAPE_INTERVAL")
  metrics_path    = "/metrics"

  forward_to = [prometheus.relabel.openwrt_bound_cardinality.receiver]
}

// ── Prometheus: drop unbounded series before they reach storage ────────────
//
// node_nat_traffic (from the required nat_traffic collector) is a full
// src x dst cross product over the conntrack table with no bound of any
// kind — see docs/client-topology-and-netflow-plan.md §0.3. It cannot be
// collapsed to a bounded per-src rollup at this layer: Alloy's relabel
// actions operate per-sample, not as an aggregation, so dropping the `dest`
// label would make same-timestamp samples for a single src collide, and
// Prometheus silently keeps only the first and drops the rest — measured
// against the live router on 2026-07-22, 11 of 19 active src had more than
// one non-zero dest, so this would have silently undercounted the majority
// of clients. Dropping the metric outright is the only correct fix at this
// layer; the Devices/Client-Insights dashboards use the traffic profile's
// per-device nftables counters (openwrt_device_traffic_bytes_total) instead.
prometheus.relabel "openwrt_bound_cardinality" {
  forward_to = [prometheus.remote_write.lgtm.receiver]

  rule {
    source_labels = ["__name__"]
    regex         = "node_nat_traffic"
    action        = "drop"
  }
}

// ── Prometheus: forward to otel-lgtm ────────────────────────────────────────

prometheus.remote_write "lgtm" {
  endpoint {
    url = "http://otel-lgtm:9090/api/v1/write"
  }
}

// ── Loki: relabel rules for syslog metadata preservation ────────────────────
//
// loki.source.syslog adds internal labels like __syslog_message_hostname,
// __syslog_message_severity, etc. Those __-prefixed labels are removed unless
// they are renamed through relabel_rules before forwarding.

loki.relabel "openwrt_syslog" {
  forward_to = [loki.write.lgtm.receiver]

  rule {
    action = "labelmap"
    regex  = "__syslog_(.+)"
  }

  // Prefer the sending device's own hostname over the single ROUTER_NAME
  // static default below, so logs from a second AP (M2, ROUTER_TARGETS)
  // label correctly instead of all being attributed to the first router.
  // regex requires a non-empty match so a listener without a hostname field
  // falls back to the static `router` label set below rather than being
  // overwritten with an empty string.
  rule {
    source_labels = ["__syslog_message_hostname"]
    regex         = "(.+)"
    target_label  = "router"
  }
}

// ── Loki: receive syslog from OpenWRT logd ──────────────────────────────────
//
// Alloy defaults syslog_format to rfc5424.
// OpenWRT remote syslog in your case is behaving like rfc3164,
// which is why Alloy complained about a missing RFC5424 version field.

loki.source.syslog "openwrt" {
  listener {
    address  = "0.0.0.0:514"
    protocol = "udp"

    syslog_format                   = "rfc3164"
    use_incoming_timestamp          = true
    rfc3164_default_to_current_year = true

    labels = {
      job    = "openwrt-syslog",
      router = sys.env("ROUTER_NAME"),
    }
  }

  listener {
    address  = "0.0.0.0:514"
    protocol = "tcp"

    syslog_format                   = "rfc3164"
    use_incoming_timestamp          = true
    rfc3164_default_to_current_year = true

    labels = {
      job    = "openwrt-syslog",
      router = sys.env("ROUTER_NAME"),
    }
  }

  relabel_rules = loki.relabel.openwrt_syslog.rules
  forward_to    = [loki.write.lgtm.receiver]
}

// ── Loki: forward to otel-lgtm ──────────────────────────────────────────────

loki.write "lgtm" {
  endpoint {
    url = "http://otel-lgtm:3100/loki/api/v1/push"
  }
}

// ── Alloy internal health metrics (optional) ────────────────────────────────

prometheus.exporter.self "alloy" {}

prometheus.scrape "alloy_self" {
  targets         = prometheus.exporter.self.alloy.targets
  scrape_interval = "30s"
  forward_to      = [prometheus.remote_write.lgtm.receiver]
}
