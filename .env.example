# OpenWrt Grafana Monitor — Configuration
# Copy this file to .env and edit the values

# ── Router ────────────────────────────────────────────────────────────────────
# IP address of your OpenWrt router
ROUTER_IP=192.168.0.1

# A friendly name for the router (used as a Grafana label)
ROUTER_NAME=openwrt

# Optional multi-router/AP scrape list. When set, this overrides ROUTER_IP,
# ROUTER_NAME, and ROUTER_METRICS_PORT for metric scraping.
# Format: name=ip:port,name=ip:port
# Example: ROUTER_TARGETS=openwrt-main=192.168.0.1:9100,openwrt-ap=192.168.0.2:9100
ROUTER_TARGETS=

# Port where prometheus-node-exporter-lua listens on the router
ROUTER_METRICS_PORT=9100

# How often to scrape metrics from the router
SCRAPE_INTERVAL=30s

# ── Monitoring host ────────────────────────────────────────────────────────────
# IP of the machine running this Docker stack (used by the router to send syslog)
# The router's `log_ip` UCI setting should point here
MONITORING_HOST_IP=192.168.0.100

# ── Grafana ────────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=changeme

# Timezone for the otel-lgtm container (affects dashboard time display).
# Defaults to UTC; set to your own IANA timezone name if you prefer local time.
TZ=UTC

# ── Syslog receiver ───────────────────────────────────────────────────────────
# Port Alloy listens on for syslog from the router (UDP + TCP)
SYSLOG_PORT=514

# ── Optional NetFlow / Akvorado ───────────────────────────────────────────────
# Per-flow visibility (who talked to whom, on which port) via softflowd on the
# router and Akvorado on this host. Opt-in, and NOT part of `docker compose up`:
#
#   cp akvorado/exporters.yaml.example akvorado/exporters.yaml   # then edit it
#   docker compose --profile netflow up -d
#
# This adds Kafka + ClickHouse and takes the stack from roughly 1 GB to 5-6 GB
# of RAM. Read docs/netflow-akvorado.md before enabling it — softflowd cannot
# see traffic handled by hardware flow offload, so the data is incomplete on
# offloading hardware and the dashboard says so explicitly.
#
# UDP ports the Akvorado inlet binds on ALL interfaces (the routers must reach
# them). The router-side default exports NetFlow v9 to NETFLOW_PORT.
NETFLOW_PORT=2055
IPFIX_PORT=4739
SFLOW_PORT=6343

# Akvorado's own web console (sankey, ad-hoc flow filtering), loopback-only and
# unauthenticated when bound directly like this. http://127.0.0.1:8081/
AKVORADO_CONSOLE_PORT=8081

# ClickHouse HTTP, loopback-only, for clickhouse-client/curl debugging. Grafana
# does not use this — it reaches ClickHouse over the compose network.
CLICKHOUSE_HTTP_PORT=8123

# Grafana plugins to preinstall at startup. The ClickHouse datasource is not
# bundled in the otel-lgtm image and is what the NetFlow dashboard queries
# through. Downloaded on first start, so Grafana needs outbound internet once.
# Set to an empty value to disable if your host is offline.
GRAFANA_PLUGINS_PREINSTALL=grafana-clickhouse-datasource

# ── Optional SSH MCP sidecar ──────────────────────────────────────────────────
# Lets Claude Code, Codex, and OpenCode use one guarded MCP server for OpenWrt
# SSH diagnostics and monitoring operations. Keep real values in untracked .env.
OPENWRT_MCP_PORT=8033
OPENWRT_MCP_TOKEN=change-me-openwrt-mcp-token
OPENWRT_MCP_ROUTERS=openwrt-main=192.168.0.1,openwrt-new=192.168.0.2
OPENWRT_MCP_ALLOWED_HOSTS=127.0.0.1,localhost
OPENWRT_MCP_ALLOWED_ORIGINS=
OPENWRT_MCP_SSH_TIMEOUT=15
OPENWRT_MCP_SETUP_TIMEOUT=600
OPENWRT_MCP_OUTPUT_LIMIT=12000
# Host path mounted read-only to /app/known_hosts inside the MCP container.
OPENWRT_MCP_KNOWN_HOSTS_FILE=./known_hosts
OPENWRT_MCP_KNOWN_HOSTS=/app/known_hosts
# Default is strict host-key verification. Set to 1 only on a trusted network.
OPENWRT_MCP_INSECURE_HOST_KEYS=
OPENWRT_SSH_USERNAME=agent
OPENWRT_SSH_PASSWORD=change-me
