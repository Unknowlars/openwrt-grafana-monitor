# UCI template for softflowd, rendered per capture interface by
# openwrt/setup.sh (the `netflow` profile) into /etc/config/softflowd.
#
# Placeholders, all substituted with sed:
#   __IFACE__            capture device -- the LAN bridge (br-lan), not WAN:
#                        WAN capture is post-SNAT and loses client identity
#   __IFINDEX__          kernel ifIndex for __IFACE__, used in NetFlow v9 input
#                        and output interface fields
#   __COLLECTOR_HOST__   monitoring host running the Akvorado inlet
#   __COLLECTOR_PORT__   inlet UDP port (NETFLOW_PORT, default 2055)
#   __SAMPLING_RATE__    softflowd -s (NETFLOW_SAMPLING_RATE, default 1)
#   __MAX_FLOWS__        flow-table cap (NETFLOW_MAX_FLOWS, default 8192)
#
# One `config softflowd` section per interface: the shipped init script is a
# config_foreach, so each section becomes its own process and therefore needs
# its own pid file and control socket.
#
# Do not edit /etc/config/softflowd on the router directly — rerunning setup.sh
# overwrites it. Change the NETFLOW_* environment variables instead.

config softflowd
	# The stock package ships enabled '0'; without this the init script starts
	# nothing and the failure looks like "NetFlow isn't arriving".
	option enabled          '1'
	# softflowd accepts ifindex:interface. Akvorado rejects records without input
	# and output interface indexes, and software capture has no real ingress vs
	# egress direction, so softflowd uses this same ifIndex for both fields.
	option interface        '__IFINDEX__:__IFACE__'
	option host_port        '__COLLECTOR_HOST__:__COLLECTOR_PORT__'

	# v9, not the package default of v5: v5 is IPv4-only and this network is
	# dual-stack. Akvorado's netflow decoder handles v5/v9/IPFIX identically,
	# so the choice costs nothing on the collector side.
	option export_version   '9'
	option track_ipv6       '1'

	# The stock default is 100 — i.e. enabling softflowd as-shipped silently
	# gives you 1-in-100 sampled counters. 1 means every packet is accounted.
	# akvorado.yaml sets default-sampling-rate to match; keep them in step.
	option sampling_rate    '__SAMPLING_RATE__'

	# Table overflow force-expires flows early, which truncates byte counts
	# without any error. openwrt-monitor-netflow-health.sh exports softflowd's
	# own drop counter so this is visible rather than silent.
	# Without this, softflowd's defaults are tcp=1h, general=1h, maxlife=1 WEEK
	# (softflowd.h DEFAULT_MAXIMUM_LIFETIME = 3600*24*7). A flow is only exported
	# when it expires, so an ongoing download or video stream contributes
	# *nothing* to the dashboard until it finishes, and then lands as one huge
	# spike stamped at expiry time rather than when the traffic happened. That
	# makes every throughput graph wrong in both shape and placement.
	#
	# maxlife=60 forces every flow to be cut and exported once a minute, which
	# matches the 1-minute rollup resolution in akvorado.yaml. The cost is more
	# flow records; on a home link that is the right trade, and it also keeps
	# the flow table smaller, which reduces forced-expiry.
	#
	# The init script maps exactly one `-t`, so only one timeout name is
	# settable here. maxlife is the right one to spend it on: it is the backstop
	# that bounds every flow regardless of protocol.
	option timeout          '__TIMEOUTS__'

	option max_flows        '__MAX_FLOWS__'
	option tracking_level   'full'

	option pid_file         '/var/run/softflowd-__IFACE__.pid'
	option control_socket   '/var/run/softflowd-__IFACE__.ctl'

	# Excludes our own export traffic from capture. With the collector on the
	# LAN, export packets traverse br-lan and softflowd would otherwise account
	# for its own telemetry as if it were user traffic.
	#
	# This is NOT runaway feedback: every export packet shares one 5-tuple, so
	# they collapse into a single flow entry with a fixed, trivial cost. The
	# filter is here for accounting hygiene -- keeping monitoring traffic out of
	# "top talkers" -- not to prevent an explosion.
	option filter           'not (host __COLLECTOR_HOST__ and udp port __COLLECTOR_PORT__)'
